{
  "name": "learn-loops",
  "version": "0.4.3",
  "description": "A learning CLI that uses Claude Code / Codex as your tutor",
  "type": "module",
  "bin": {
    "loops": "dist/cli.js"
  },
  "scripts": {
    "build": "rm -rf dist && tsc && chmod +x dist/cli.js",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "@resvg/resvg-js": "^2.6.2",
    "beautiful-mermaid": "^1.1.3",
    "cli-table3": "^0.6.5",
    "mathjax-full": "^3.2.1",
    "mathjs": "^15.2.0",
    "picocolors": "^1.1.1",
    "unicodeit": "^0.7.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "learning",
    "cli",
    "claude-code",
    "codex",
    "mermaid",
    "spaced-repetition",
    "tutor"
  ]
}
